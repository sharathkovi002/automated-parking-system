# Database Configuration
DATABASE_URL=postgresql://digital_twin:digital_twin_password@localhost:5432/digital_twin

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# File Upload Configuration
MAX_FILE_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=uploads
PROCESSED_DIR=processed

# Security
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/digital_twin.log

# AI/ML Configuration
TORCH_DEVICE=cpu
MODEL_CACHE_DIR=models

# FreeCAD Configuration
FREECAD_PATH=/usr/bin/freecad
FREECAD_SCRIPT_DIR=scripts

# Processing Configuration
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT=3600  # 1 hour in seconds

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000